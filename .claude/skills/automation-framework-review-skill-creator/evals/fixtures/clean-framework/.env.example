# Copy this file to .env and fill in values for your target environment.
# .env is gitignored and must never be committed.

# Base URL of the Storefront Admin panel under test.
BASE_URL=https://staging.storefront-admin.example.com

# Seeded test accounts (created by the test-data reset job in each environment).
ADMIN_USERNAME=admin.qa@example.com
ADMIN_PASSWORD=replace-me
STANDARD_USERNAME=agent.qa@example.com
STANDARD_PASSWORD=replace-me

# Optional: API base for any direct test-data seeding calls used by factories.
API_BASE_URL=https://staging.api.storefront-admin.example.com
