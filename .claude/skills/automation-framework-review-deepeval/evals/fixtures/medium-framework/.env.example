# Copy this file to .env and fill in real values. Never commit the real .env file.

SUBTRACK_BASE_URL=https://admin.subtrack.staging.example.com
SUBTRACK_API_BASE_URL=https://api.subtrack.staging.example.com

# Default admin user used by most UI/hybrid tests (see src/core/auth.py AuthContext)
SUBTRACK_ADMIN_USERNAME=qa-admin@subtrack.example.com
SUBTRACK_ADMIN_PASSWORD=changeme

# Service-account API token used by a handful of API-only tests
SUBTRACK_API_TOKEN=changeme

# Third-party invoicing provider key used by billing sync tests
INVOICING_PROVIDER_API_KEY=changeme
